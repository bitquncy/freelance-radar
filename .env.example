# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
OWNER_CHAT_ID=your_telegram_user_id_here

# AI Configuration (OpenAI or OpenRouter)
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
# Для OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Для OpenAI: оставьте пустым или удалите строку
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini

# Telegram User API (optional, HTTP parser is used by default)
# TELEGRAM_API_ID=your_api_id_here
# TELEGRAM_API_HASH=your_api_hash_here

# Database Configuration
DB_PATH=freelance_radar.db

# Kwork Parser Configuration
KWORK_PROJECTS_URL=https://kwork.ru/projects
KWORK_REQUEST_DELAY_MIN=2.0
KWORK_REQUEST_DELAY_MAX=5.0
KWORK_MAX_PAGES=1
KWORK_MAX_DETAIL_PAGES=5

# Monitoring Configuration
MONITOR_INTERVAL_MINUTES=15

# Default Settings
DEFAULT_COOLDOWN_SEC=3600

# --- FreelanceRadar V2 (AGENTS.md) ---
# Включение V2-слоя (мульти-тенантный радар: скоринг, CRM, тарифы)
RADAR_V2_ENABLED=false

# V2 БД: PostgreSQL в проде (AGENTS.md §4.2), SQLite для локальной разработки
DATABASE_URL=sqlite+aiosqlite:///freelance_radar_v2.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/freelanceradar

# Redis (очередь/дедуп-кэш, опционально на MVP)
REDIS_URL=

# LLM-шлюз OpenRouter (AGENTS.md §6.1): дешёвая модель на экстракцию,
# сильная — только на генерацию отклика
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_MODEL=openai/gpt-4o-mini
GENERATION_MODEL=anthropic/claude-3.5-sonnet

# Telethon (отдельный аккаунт, только чтение — AGENTS.md §8)
# TELETHON_API_ID=your_api_id
# TELETHON_API_HASH=your_api_hash
# TELETHON_SESSION_NAME=radar_monitor

# Платежи: Telegram Payments (BotFather → Payments → ЮKassa)
# Пусто = кнопки оплаты отвечают «скоро», работает ручной /grant
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=RUB
# Резерв под чек-аут на сайте (Фаза 4)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
