# Railway environment variables
# Add these in the bot service Variables section. Rename Postgres/Redis below
# if your Railway services use different names.

# Required application settings
BOT_TOKEN=replace_with_botfather_token
OWNER_CHAT_ID=123456789
RADAR_V2_ENABLED=true
ENVIRONMENT=production
BOT_REPLICAS=1

# Railway service references (not literal credentials)
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# V2 LLM gateway
OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_MODEL=openai/gpt-4o-mini
GENERATION_MODEL=anthropic/claude-3.5-sonnet

# Legacy OpenAI-compatible path; optional when OPENROUTER_API_KEY is set
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional Telethon credentials for Telegram channel monitoring
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION_NAME=radar_monitor

# Parser and monitoring settings
KWORK_PROJECTS_URL=https://kwork.ru/projects
KWORK_REQUEST_DELAY_MIN=2.0
KWORK_REQUEST_DELAY_MAX=5.0
KWORK_MAX_PAGES=1
KWORK_MAX_DETAIL_PAGES=5
KWORK_DAILY_REQUEST_LIMIT=200
MONITOR_INTERVAL_MINUTES=15
DEFAULT_COOLDOWN_SEC=3600

# Runtime
PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright
PYTHONUNBUFFERED=1
