# Railway Environment Variables Template
# Copy these to Railway Variables section

# ==============================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ==============================================

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram User ID владельца бота (получить у @userinfobot)
OWNER_CHAT_ID=123456789

# OpenAI API Key (получить на platform.openai.com)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ (Telethon)
# ==============================================

# Telegram API credentials (получить на my.telegram.org/apps)
# Требуется только если используете Telethon для отправки сообщений
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# ==============================================
# КОНФИГУРАЦИЯ БАЗЫ ДАННЫХ
# ==============================================

# Путь к SQLite базе данных (в Railway Volume)
DB_PATH=/app/data/freelance_radar.db

# ==============================================
# НАСТРОЙКИ ПАРСЕРА KWORK
# ==============================================

# URL страницы проектов Kwork
KWORK_PROJECTS_URL=https://kwork.ru/projects

# Задержка между запросами (секунды)
KWORK_REQUEST_DELAY_MIN=2.0
KWORK_REQUEST_DELAY_MAX=5.0

# Количество страниц для парсинга
KWORK_MAX_PAGES=1
KWORK_MAX_DETAIL_PAGES=5

# ==============================================
# НАСТРОЙКИ МОНИТОРИНГА
# ==============================================

# Интервал проверки источников (минуты)
MONITOR_INTERVAL_MINUTES=15

# ==============================================
# ДРУГИЕ НАСТРОЙКИ
# ==============================================

# Кулдаун для повторной отправки сообщений (секунды)
DEFAULT_COOLDOWN_SEC=3600

# OpenAI модель
OPENAI_MODEL=gpt-4o-mini

# User-Agent для HTTP запросов
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ==============================================
# ПЕРЕМЕННЫЕ ДЛЯ PLAYWRIGHT (автоматически)
# ==============================================

PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright
PYTHONUNBUFFERED=1
